<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ada.Url</RootNamespace>
    <AssemblyName>Ada.Url</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <PackageId>Ada.Url</PackageId>
    <Version>0.1.0-beta.1</Version>
    <Description>Zero-allocation .NET wrapper around the Ada WHATWG-compliant URL parser.</Description>
    <PackageTags>url;uri;whatwg;parser;ada;idna;performance</PackageTags>
    <!-- Without this the nuget.org page shows no project website link at all. -->
    <PackageProjectUrl>https://github.com/sanamhub/ada-csharp</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Native assets, one entry per shipped RID, taken from artifacts/native/<rid>/ which is where
    native.yml writes and where the release workflow downloads them to.

    Wildcards rather than literal file names. A literal Include of a missing file is a build
    error, while a wildcard that matches nothing is silently empty, so a developer with no C++
    toolchain can still build and test the managed side.

    Silence at pack time is the danger, so the gate is on the pack instead. Before this target
    existed, dotnet pack happily produced a package with no runtimes/ folder at all, which
    installs fine and then throws DllNotFoundException on the consumer's first call.
  -->
  <PropertyGroup>
    <AdaNativeRoot Condition="'$(AdaNativeRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\native\</AdaNativeRoot>
    <AdaShippedRids>win-x64;linux-x64;linux-arm64;linux-musl-x64;osx-x64;osx-arm64</AdaShippedRids>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(AdaNativeRoot)win-x64\*.dll" Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false" />
    <None Include="$(AdaNativeRoot)linux-x64\*.so" Pack="true" PackagePath="runtimes/linux-x64/native/" Visible="false" />
    <None Include="$(AdaNativeRoot)linux-arm64\*.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" Visible="false" />
    <None Include="$(AdaNativeRoot)linux-musl-x64\*.so" Pack="true" PackagePath="runtimes/linux-musl-x64/native/" Visible="false" />
    <None Include="$(AdaNativeRoot)osx-x64\*.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/" Visible="false" />
    <None Include="$(AdaNativeRoot)osx-arm64\*.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" Visible="false" />
  </ItemGroup>

  <Target Name="VerifyNativeAssets" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_AdaExpectedRid Include="$(AdaShippedRids)" />
      <_AdaMissingRid Include="@(_AdaExpectedRid)" Condition="!Exists('$(AdaNativeRoot)%(Identity)')" />
    </ItemGroup>

    <Error Condition="'@(_AdaMissingRid)' != '' and '$(AllowPartialNativePack)' != 'true'"
           Text="Cannot pack Ada.Url: no native library for @(_AdaMissingRid, ', '). Build with native/build-* or download the native.yml artifacts into $(AdaNativeRoot). AllowPartialNativePack=true bypasses this for a local smoke test only, never for a release." />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Ada.Url.Tests" />
  </ItemGroup>

</Project>
