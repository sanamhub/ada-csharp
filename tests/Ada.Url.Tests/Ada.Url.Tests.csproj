<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ada.Url.Tests</RootNamespace>
    <AssemblyName>Ada.Url.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup>
    <!-- The corpus is the specification this library is tested against, so it has to reach the
         output directory. If it does not, the suite passes by running nothing. -->
    <Content Include="vectors\**" CopyToOutputDirectory="PreserveNewest" LinkBase="vectors" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ada.Url\Ada.Url.csproj" />
  </ItemGroup>

</Project>
