root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,props,targets,csproj}]
indent_size = 2

[*.{md}]
trim_trailing_whitespace = false

[*.cs]
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_readonly_field = true:error
dotnet_style_require_accessibility_modifiers = always:error

# Naming: private fields _camelCase, constants PascalCase.
dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# XML docs are required on the public surface (org §9).
dotnet_diagnostic.CS1591.severity = error

# This is a P/Invoke wrapper. These are the point of the library, not smells.
dotnet_diagnostic.CA1401.severity = none    # P/Invokes should not be visible  (they are internal anyway)
dotnet_diagnostic.SYSLIB1054.severity = error  # use LibraryImport, never DllImport

[src/Ada.Url/Interop/*.cs]
# Interop is the only place unsafe pointer style is expected.
dotnet_diagnostic.CA1051.severity = none    # visible instance fields (blittable ABI structs)

[tests/**/*.cs]
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CA1707.severity = none    # Method_DescribesBehaviour is the test naming convention
dotnet_diagnostic.CA1515.severity = none    # test classes must be public for the runner

[benchmarks/**/*.cs]
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
# BenchmarkDotNet discovers instance methods on the benchmark class. Making them static to
# please the analyzer would change what it measures.
dotnet_diagnostic.CA1822.severity = none

[src/**.cs]
# The C ABI returns uint8_t for these, so byte is the correct underlying type. Widening to int
# would misrepresent the native contract.
dotnet_diagnostic.CA1028.severity = none

# CA5393 objects to AssemblyDirectory because it is not a fixed OS directory. For a library that
# ships its own native binary that is exactly where the binary lives, and the assembly level
# DefaultDllImportSearchPaths is still narrower than the default probing order, which includes
# the current working directory. Removing the attribute would be less safe, not more.
dotnet_diagnostic.CA5393.severity = none

# CA2000 cannot follow a ref struct handed back through an out parameter. Every site it flags
# already disposes with a using statement on the success path, and on the failure path the value
# is default and owns nothing.
dotnet_diagnostic.CA2000.severity = none
